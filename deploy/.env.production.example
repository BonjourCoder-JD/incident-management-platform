# Production settings for deploy/compose.prod.yaml. Copy to deploy/.env.production on the server,
# fill in, and restrict it: chmod 600 deploy/.env.production. Never commit the copy.

# Public hostname (for example your-name.duckdns.org). Caddy obtains its HTTPS certificate for it.
SITE_ADDRESS=

# Schema owner password (migrations only): generate it, for example `openssl rand -hex 32` (letters and digits only,
# because it is also used inside the database URL). Required, at least 24 characters; there is no default.
POSTGRES_PASSWORD=

# Password of the least-privilege runtime role (imp_app) that the API and the worker use. Generate it
# the same way, and make it different from POSTGRES_PASSWORD. Required, at least 24 characters.
APP_DB_PASSWORD=

# Simulated AI triage for the public demo. The paid provider is refused at start-up in production.
TRIAGE_PROVIDER=fake

# Optional: public-demo writes per client IP per hour (defaults 20 incidents, 60 comments, 20 triage requests).
# WRITE_LIMIT_INCIDENTS_PER_HOUR=20
# WRITE_LIMIT_COMMENTS_PER_HOUR=60
# WRITE_LIMIT_TRIAGE_PER_HOUR=20

# Public demo (Milestone 6 Phase C): start with `--profile demo`. The demo database name must end in
# _demo; the daily 04:00 UTC reset refuses any other database. Demo data is synthetic.
# DEMO_MODE=true
# POSTGRES_DB=incidents_demo

# Backups (Milestone 6 Phase D): a daily dump of POSTGRES_DB into the "backups" volume.
# BACKUP_KEEP=7
# BACKUP_TIME_UTC=03:30
