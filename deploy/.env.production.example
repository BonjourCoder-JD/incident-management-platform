# Production settings for deploy/compose.prod.yaml. Copy to deploy/.env.production on the server,
# fill in, and restrict it: chmod 600 deploy/.env.production. Never commit the copy.

# Public hostname (for example your-name.duckdns.org). Caddy obtains its HTTPS certificate for it.
SITE_ADDRESS=

# Database password: generate it, for example `openssl rand -hex 32` (letters and digits only,
# because it is also used inside the database URL). Required, at least 24 characters; there is no default.
POSTGRES_PASSWORD=

# Simulated AI triage for the public demo. The paid provider is refused at start-up in production.
TRIAGE_PROVIDER=fake
